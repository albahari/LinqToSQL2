<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AdventureWorks2008</AssemblyName>
    <RootNamespace>AdventureWorks2008</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);SYSLIB0011;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Old .NET Framework AssemblyInfo (duplicate attributes) and the native SqlServerTypes
         loader (superseded by the managed dotMorten SqlServer.Types package) are excluded. -->
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="SqlServerTypes\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AdventureWorks2008Mappings.xml">
      <LogicalName>AdventureWorks2008.AdventureWorks2008Mappings.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SD.Tools.LinqToSQL2.csproj" />
    <PackageReference Include="dotMorten.Microsoft.SqlServer.Types" Version="1.5.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

</Project>
